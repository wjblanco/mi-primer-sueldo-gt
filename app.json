{
  "expo": {
    "name": "Mi Primer Sueldo GT",
    "slug": "mi-primer-sueldo-gt",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "scheme": "miprimersueldogt",
    "userInterfaceStyle": "light",
    "newArchEnabled": true,
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#FAFAF8"
    },
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "gt.miprimersueldo.app",
      "buildNumber": "1",
      "infoPlist": {
        "CFBundleDisplayName": "Mi Primer Sueldo GT",
        "ITSAppUsesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#FAFAF8"
      },
      "package": "gt.miprimersueldo.app",
      "versionCode": 1,
      "edgeToEdgeEnabled": true,
      "permissions": []
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font"
    ],
    "extra": {
      "eas": {
        "projectId": "73b4d12d-8a15-4569-ab91-87d9590fd3a3"
      }
    },
    "owner": "wilson-blanco"
  }
}
